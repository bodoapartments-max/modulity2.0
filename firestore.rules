rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Deterministic membership lookup using subcollection path:
    //   organizations/{orgId}/members/{userId}
    function getMemberDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function memberExists(orgId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isActiveMember(orgId) {
      return memberExists(orgId)
        && getMemberDoc(orgId).data.status == 'ACTIVE';
    }

    function isSuspendedMember(orgId) {
      return memberExists(orgId)
        && getMemberDoc(orgId).data.status == 'SUSPENDED';
    }

    function hasRole(orgId, role) {
      return isActiveMember(orgId)
        && getMemberDoc(orgId).data.roles.hasAny([role]);
    }

    function isOwner(orgId) {
      return hasRole(orgId, 'OWNER');
    }

    function isAdminOrOwner(orgId) {
      return hasRole(orgId, 'ADMIN') || hasRole(orgId, 'OWNER');
    }

    // Field change detection helpers
    function fieldUnchanged(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    // Actor identity enforcement for client writes.
    // Clients may only claim actorType == 'USER' and actorId == their own uid.
    // INTERNAL_AGENT and EXTERNAL_INTEGRATION must enter through a trusted backend.
    function isValidClientActor(actorField) {
      return actorField.actorType == 'USER'
        && actorField.actorId == request.auth.uid;
    }

    function isValidAnalyticsSourceAt(sources, index, workspaceId) {
      return sources.size() <= index
        || (sources[index].sourceType in ['RECORDS', 'ENTITIES', 'RELATIONSHIPS']
          && !('collectionPath' in sources[index])
          && (sources[index].sourceType != 'RECORDS'
            || (sources[index].moduleId is string
              && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/modules/$(sources[index].moduleId)))));
    }

    function isBoundedCapabilityConfiguration(data) {
      return data.configuration is map
        && !('collectionPath' in data.configuration)
        && !('firestorePath' in data.configuration)
        && !('rawQuery' in data.configuration)
        && !('script' in data.configuration)
        && !('scriptUrl' in data.configuration)
        && !('moduleUrl' in data.configuration)
        && !('executable' in data.configuration)
        && !('expression' in data.configuration)
        && !('eval' in data.configuration)
        && !('function' in data.configuration)
        && !('componentCode' in data.configuration)
        && !('jsx' in data.configuration);
    }

    function isValidCapabilityDefinition(data, workspaceId) {
      return data.workspaceId == workspaceId
        && data.definitionId is string
        && data.definitionVersion == '1.0.0'
        && data.engineId is string
        && data.engineId in ['calendar']
        && data.contractVersion == '1.0.0'
        && data.status in ['DRAFT', 'ACTIVE', 'INACTIVE', 'ARCHIVED']
        && data.source is map
        && data.source.kind in ['MODULE', 'ENTITY_TYPE', 'WORKSET']
        && data.source.ref is string
        && (data.source.kind == 'MODULE' ? data.source.ref.matches('module:.*') : true)
        && (data.source.kind == 'ENTITY_TYPE' ? data.source.ref.matches('entityType:.*') : true)
        && (data.source.kind == 'WORKSET' ? data.source.ref.matches('workset:.*') : true)
        && data.source.workspaceId == workspaceId
        && isBoundedCapabilityConfiguration(data);
    }

    function isBoundedAnalyticsDefinition(data, workspaceId) {
      return data.dataSources is list && data.dataSources.size() >= 1 && data.dataSources.size() <= 5
        && isValidAnalyticsSourceAt(data.dataSources, 0, workspaceId)
        && isValidAnalyticsSourceAt(data.dataSources, 1, workspaceId)
        && isValidAnalyticsSourceAt(data.dataSources, 2, workspaceId)
        && isValidAnalyticsSourceAt(data.dataSources, 3, workspaceId)
        && isValidAnalyticsSourceAt(data.dataSources, 4, workspaceId)
        && data.filters is list && data.filters.size() <= 10
        && data.metrics is list && data.metrics.size() <= 8
        && data.columns is list && data.columns.size() <= 12
        && data.groupBy is list && data.groupBy.size() <= 2
        && data.sort is list && data.sort.size() <= 3;
    }

    function isBoundedWidgetDefinition(data) {
      return data.source in ['RECORDS', 'ENTITIES', 'RELATIONSHIPS']
        && data.type in ['KPI', 'STATUS_SUMMARY', 'RECENT_RECORDS', 'ASSIGNMENT', 'TABLE']
        && data.filters is list && data.filters.size() <= 10
        && data.columns is list && data.columns.size() <= 12
        && data.display.limit is int && data.display.limit >= 1 && data.display.limit <= 100
        && !('collectionPath' in data);
    }

    // ─── Users (Person/Profile) ─────────────────────────────
    // Path: users/{userId}
    // Only the owner can read/write their profile.

    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if false;
    }

    // ─── Workspaces ─────────────────────────────────────────
    // Path: workspaces/{workspaceId}

    match /workspaces/{workspaceId} {
      // Deterministic Personal Workspace path must be readable before creation.
      // Existing Personal/Organization workspaces remain owner/member scoped.
      allow get: if isAuthenticated()
        && (
          workspaceId == 'personal_' + request.auth.uid
          || (resource.data.type == 'PERSONAL' && resource.data.ownerUserId == request.auth.uid)
          || (resource.data.type == 'ORGANIZATION' && isActiveMember(resource.data.organizationId))
        );

      allow list: if isAuthenticated()
        && (
          (resource.data.type == 'PERSONAL' && resource.data.ownerUserId == request.auth.uid)
          || (resource.data.type == 'ORGANIZATION' && isActiveMember(resource.data.organizationId))
        );

      // Create personal workspace: only for yourself
      allow create: if isAuthenticated()
        && request.resource.data.type == 'PERSONAL'
        && request.resource.data.ownerUserId == request.auth.uid;

      // Create organization workspace: only during org bootstrap
      // (creator must match the org's createdByUserId — checked via batch)
      allow create: if isAuthenticated()
        && request.resource.data.type == 'ORGANIZATION'
        && request.resource.data.organizationId != null;

      // Update: personal workspace owner or org admin/owner
      // Protected fields: type, ownerUserId cannot be changed
      allow update: if isAuthenticated()
        && fieldUnchanged('type')
        && fieldUnchanged('ownerUserId')
        && fieldUnchanged('dataGeneration')
        && fieldUnchanged('lastResetAt')
        && fieldUnchanged('lastResetBy')
        && (
          (resource.data.type == 'PERSONAL' && resource.data.ownerUserId == request.auth.uid)
          ||
          (resource.data.type == 'ORGANIZATION' && isAdminOrOwner(resource.data.organizationId))
        );

      allow delete: if false;

      function canAccessWorkspace() {
        return isAuthenticated() && (
          (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
          || (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
            && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
        );
      }

      function canManageWorkspace() {
        return isAuthenticated() && (
          (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
          || (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
            && isAdminOrOwner(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
        );
      }

      function userCanAccessWorkspace(userId) {
        return (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == userId)
          || (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
            && exists(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId)/members/$(userId))
            && get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId)/members/$(userId)).data.status == 'ACTIVE');
      }

      function isConversationMember(conversationId) {
        return isAuthenticated()
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/conversations/$(conversationId)/members/$(request.auth.uid));
      }

      // ─── Workspace Data Subcollections ───────────────────
      // Universal Data Core: entityTypes, entities, relationships, records, files
      // Access requires workspace ownership (personal) or active org membership (org).

      // ─── Entity Types ────────────────────────────────────
      // Path: workspaces/{workspaceId}/entityTypes/{typeId}

      match /entityTypes/{typeId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('typeId')
          && fieldUnchanged('category')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isAdminOrOwner(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          )
          && resource.data.category != 'CORE';

        allow delete: if false;
      }

      // ─── Entities ────────────────────────────────────────
      // Path: workspaces/{workspaceId}/entities/{entityId}

      match /entities/{entityId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Actor enforcement: client must claim USER + own uid.
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy != null
          && isValidClientActor(request.resource.data.createdBy)
          && request.resource.data.status in ['ACTIVE', 'INACTIVE', 'ARCHIVED']
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow update: if isAuthenticated()
          && request.resource.data.status in ['ACTIVE', 'INACTIVE', 'ARCHIVED']
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('entityId')
          && fieldUnchanged('createdBy')
          && fieldUnchanged('createdAt')
          && fieldUnchanged('_createdAt')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow delete: if false;
      }

      // ─── Relationships ───────────────────────────────────
      // Path: workspaces/{workspaceId}/relationships/{relationshipId}

      match /relationships/{relationshipId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Actor enforcement: client must claim USER + own uid.
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy != null
          && isValidClientActor(request.resource.data.createdBy)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('relationshipId')
          && fieldUnchanged('createdBy')
          && fieldUnchanged('createdAt')
          && fieldUnchanged('_createdAt')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow delete: if false;
      }

      // ─── Records ─────────────────────────────────────────
      // Path: workspaces/{workspaceId}/records/{recordId}
      //
      // IMMUTABILITY POLICY (Step 5.1):
      //   ALWAYS immutable: workspaceId, recordId, createdBy, createdAt, _createdAt,
      //     moduleId, moduleVersion, recordType, sourceRequestId, submittedBy
      //   DRAFT records: data/entityReferences may be updated (via RecordService).
      //   SUBMITTED/ACTIVE/COMPLETED/CANCELLED/ARCHIVED records:
      //     data, entityReferences, entityReferenceIds are frozen.
      //     Only operational fields may change: status, priority, _previousStatus, archivedAt, archivedBy.

      match /records/{recordId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Create: disallowed from browser clients. Canonical Record creation is
        // server-authoritative via the trusted recordCommand callable.
        allow create: if false;

        // Update: provenance + sourceRequestId always immutable.
        // SUBMITTED+ records: data/entityReferences/submittedBy also immutable.
        allow update: if isAuthenticated()
          // Always-immutable provenance fields
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('recordId')
          && fieldUnchanged('createdBy')
          && fieldUnchanged('createdAt')
          && fieldUnchanged('_createdAt')
          && fieldUnchanged('moduleId')
          && fieldUnchanged('moduleVersion')
          && fieldUnchanged('recordType')
          && fieldUnchanged('sourceRequestId')
          && fieldUnchanged('submittedBy')
          // Ledger linkage immutable after assignment
          && (resource.data.ledgerEntryId == null || fieldUnchanged('ledgerEntryId'))
          && (resource.data.ledgerBookId == null || fieldUnchanged('ledgerBookId'))
          && (resource.data.referenceNumber == null || fieldUnchanged('referenceNumber'))
          // Submitted Record business data immutability:
          // If status is not DRAFT, data/entityReferences/entityReferenceIds are frozen.
          && (
            resource.data.status == 'DRAFT'
            || (
              fieldUnchanged('data')
              && fieldUnchanged('entityReferences')
              && fieldUnchanged('entityReferenceIds')
            )
          )
          // Workspace access
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow delete: if false;
      }

      // ─── Record Command Operations ────────────────────────
      // Path: workspaces/{workspaceId}/recordOperations/{operationId}
      // Server-only operational journal for trusted Record commands.
      // Clients must never write or tamper with operation state.

      match /recordOperations/{operationId} {
        allow read, create, update, delete: if false;
      }

      // ─── Files ───────────────────────────────────────────
      // Path: workspaces/{workspaceId}/files/{fileId}

      match /files/{fileId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Actor enforcement: uploadedBy must claim USER + own uid.
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.uploadedBy != null
          && isValidClientActor(request.resource.data.uploadedBy)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow update: if false;
        allow delete: if false;
      }

      // ─── Modules ──────────────────────────────────────────
      // Path: workspaces/{workspaceId}/modules/{moduleId}

      match /modules/{moduleId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Actor enforcement: createdBy must claim USER + own uid.
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy != null
          && isValidClientActor(request.resource.data.createdBy)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isAdminOrOwner(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Update: immutable fields; org users need admin/owner.
        // moduleCode immutable after creation to protect Record references.
        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('moduleId')
          && fieldUnchanged('moduleCode')
          && fieldUnchanged('createdBy')
          && fieldUnchanged('createdAt')
          && fieldUnchanged('_createdAt')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isAdminOrOwner(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          )
          // Archived modules cannot be modified (except to re-archive, which is a no-op)
          && (resource.data.status != 'ARCHIVED' || request.resource.data.status == 'ARCHIVED');

        allow delete: if false;

        // ─── Module Version Snapshots ──────────────────────
        // Path: workspaces/{workspaceId}/modules/{moduleId}/versions/{version}
        // IMMUTABLE after creation. These preserve historical schema for Record interpretation.

        match /versions/{version} {
          // Read: same workspace access rules as parent module
          allow read: if isAuthenticated()
            && (
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
                && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
                && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
            );

          // Create: workspace access + actor validation + workspaceId/moduleId match
          allow create: if isAuthenticated()
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.moduleId == moduleId
            && request.resource.data.createdBy != null
            && isValidClientActor(request.resource.data.createdBy)
            && (
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
                && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
                && isAdminOrOwner(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
            );

          // IMMUTABLE: no updates, no deletes
          allow update: if false;
          allow delete: if false;
        }
      }

      // ─── Module Code Reservations ─────────────────────────
      // Path: workspaces/{workspaceId}/moduleCodes/{normalizedCode}
      // Atomic identity reservation. NEVER reused, even after archiving.

      match /moduleCodes/{codeId} {
        // Read: workspace members can check if code is reserved
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Create: workspace access + workspaceId match + actor validation
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.reservedBy != null
          && isValidClientActor(request.resource.data.reservedBy)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isAdminOrOwner(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // IMMUTABLE: no updates, no deletes — codes are never reused
        allow update: if false;
        allow delete: if false;
      }

      // ─── Deliveries ──────────────────────────────────────
      // Path: workspaces/{workspaceId}/deliveries/{deliveryId}
      // Record sharing/sending. NOT a Record copy.

      match /deliveries/{deliveryId} {
        // Read: sender or recipient (workspace member)
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Create: workspace member, sender must be self, workspaceId must match
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.sender != null
          && isValidClientActor(request.resource.data.sender)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Update: sender can revoke, recipient can update status
        // Immutable: workspaceId, deliveryId, recordId, sender, recipientUserId, deliveryType
        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('recordId')
          && fieldUnchanged('sender')
          && fieldUnchanged('recipientUserId')
          && fieldUnchanged('deliveryType')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow delete: if false;
      }

      // ─── Form Requests ───────────────────────────────────
      // Path: workspaces/{workspaceId}/formRequests/{requestId}
      // Asks someone to create a new Record. Locks Module Version.

      match /formRequests/{requestId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Create: workspace member, requester must be self
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.requester != null
          && isValidClientActor(request.resource.data.requester)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Update: immutable fields protected.
        // resultRecordId is immutable once set (prevents pointing at arbitrary Records).
        // Completion must happen via atomic transaction (not client field manipulation).
        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('requestId')
          && fieldUnchanged('moduleId')
          && fieldUnchanged('moduleVersion')
          && fieldUnchanged('requester')
          && fieldUnchanged('recipientUserId')
          && fieldUnchanged('_createdAt')
          // resultRecordId: immutable once set (non-null)
          && (
            !(('resultRecordId' in resource.data) && resource.data.resultRecordId != null)
            || fieldUnchanged('resultRecordId')
          )
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow delete: if false;
      }

      // ─── Folders ─────────────────────────────────────────
      // Path: workspaces/{workspaceId}/folders/{folderId}
      // Organize Records without copying them.

      match /folders/{folderId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy != null
          && isValidClientActor(request.resource.data.createdBy)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Update: immutable fields protected
        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('folderId')
          && fieldUnchanged('createdBy')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // USER-scoped folders can be deleted by their owner
        allow delete: if isAuthenticated()
          && resource.data.scope == 'USER'
          && resource.data.ownerUserId == request.auth.uid;

        // ─── Folder Items ──────────────────────────────────
        // Path: workspaces/{workspaceId}/folders/{folderId}/items/{itemId}

        match /items/{itemId} {
          allow read: if isAuthenticated()
            && (
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
                && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
                && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
            );

          allow create: if isAuthenticated()
            && (
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
                && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
                && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
            );

          allow delete: if isAuthenticated()
            && (
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
                && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
                && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
            );

          allow update: if false;
        }
      }

      // ─── User Record State ───────────────────────────────
      // Path: workspaces/{workspaceId}/userRecordState/{stateId}
      // Per-user state (starred). stateId = userId_recordId (deterministic).
      // Only the owning user can read/write their own state.

      match /userRecordState/{stateId} {
        // Read: only if the state belongs to the authenticated user
        allow read: if isAuthenticated()
          && resource.data.userId == request.auth.uid;

        // Create: user can only create their own state
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.userId == request.auth.uid;

        // Update: user can only update their own state
        allow update: if isAuthenticated()
          && resource.data.userId == request.auth.uid
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('userId')
          && fieldUnchanged('recordId');

        allow delete: if false;
      }

      // ─── Share Tokens ────────────────────────────────────
      // Path: workspaces/{workspaceId}/shareTokens/{tokenId}
      // Secure share foundation. Only token HASH stored, never plaintext.

      match /shareTokens/{tokenId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy != null
          && isValidClientActor(request.resource.data.createdBy)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Update: only creator can revoke; immutable fields protected
        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('recordId')
          && fieldUnchanged('tokenHash')
          && fieldUnchanged('createdBy')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow delete: if false;
      }

      // ─── Worksets ─────────────────────────────────────────
      match /worksets/{worksetId} {
        allow read: if isAuthenticated() && (
          (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
          || (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
            && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
        );
        allow create: if canAccessWorkspace()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.worksetId == worksetId
          && isValidClientActor(request.resource.data.createdBy);
        allow update: if canAccessWorkspace()
          && fieldUnchanged('workspaceId') && fieldUnchanged('worksetId') && fieldUnchanged('createdBy');
        allow delete: if false;
      }

      // ─── Widget Definitions ────────────────────────────────
      match /widgetDefinitions/{widgetId} {
        allow read: if canAccessWorkspace()
          && (resource.data.ownerUserId == request.auth.uid || canManageWorkspace());
        allow create: if canAccessWorkspace()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.widgetId == widgetId
          && request.resource.data.ownerUserId == request.auth.uid
          && isValidClientActor(request.resource.data.createdBy)
          && isBoundedWidgetDefinition(request.resource.data);
        allow update: if resource.data.ownerUserId == request.auth.uid
          && fieldUnchanged('workspaceId') && fieldUnchanged('widgetId')
          && fieldUnchanged('ownerUserId') && fieldUnchanged('createdBy')
          && isBoundedWidgetDefinition(request.resource.data);
        allow delete: if false;
      }

      // ─── Report Definitions ────────────────────────────────
      match /reportDefinitions/{reportId} {
        allow read: if canAccessWorkspace();
        allow create: if canAccessWorkspace()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.reportId == reportId
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.version == 1
          && isValidClientActor(request.resource.data.createdBy)
          && isBoundedAnalyticsDefinition(request.resource.data, workspaceId);
        allow update: if canAccessWorkspace()
          && resource.data.createdBy.actorId == request.auth.uid
          && fieldUnchanged('workspaceId') && fieldUnchanged('reportId')
          && fieldUnchanged('createdBy') && fieldUnchanged('_createdAt')
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.status in ['ACTIVE', 'ARCHIVED']
          && isBoundedAnalyticsDefinition(request.resource.data, workspaceId);
        allow delete: if false;
      }

      match /automatPlans/{planId} {
        allow read: if canAccessWorkspace();
        allow create, update, delete: if false;
      }

      // ─── Capability Definitions ─────────────────────────────
      // Path: workspaces/{workspaceId}/capabilityDefinitions/{definitionId}
      // Declarative engine configuration. No business data, no executable config.

      match /capabilityDefinitions/{definitionId} {
        allow read: if canAccessWorkspace();
        allow create: if canManageWorkspace()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.definitionId == definitionId
          && isValidClientActor(request.resource.data.createdBy)
          && isValidCapabilityDefinition(request.resource.data, workspaceId);
        allow update: if canManageWorkspace()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('definitionId')
          && fieldUnchanged('engineId')
          && fieldUnchanged('contractVersion')
          && fieldUnchanged('definitionVersion')
          && fieldUnchanged('createdBy')
          && fieldUnchanged('_createdAt')
          && request.resource.data.source.workspaceId == workspaceId
          && request.resource.data.status in ['DRAFT', 'ACTIVE', 'INACTIVE', 'ARCHIVED']
          && isBoundedCapabilityConfiguration(request.resource.data);
        allow delete: if canManageWorkspace();
      }

      // ─── Notifications ─────────────────────────────────────
      match /notifications/{notificationId} {
        allow read: if canAccessWorkspace()
          && resource.data.recipientUserId == request.auth.uid;
        allow create: if canAccessWorkspace()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.notificationId == notificationId
          && isValidClientActor(request.resource.data.createdBy);
        allow update: if resource.data.recipientUserId == request.auth.uid
          && fieldUnchanged('workspaceId') && fieldUnchanged('notificationId')
          && fieldUnchanged('recipientUserId') && fieldUnchanged('type')
          && fieldUnchanged('resourceType') && fieldUnchanged('resourceId')
          && fieldUnchanged('createdBy') && fieldUnchanged('_createdAt');
        allow delete: if false;
      }

      // ─── User Workspace Preferences ────────────────────────
      match /userWorkspacePreferences/{userId} {
        // Deterministic owner path: allow get even before the preference document exists.
        allow get: if isUser(userId) && canAccessWorkspace();
        allow list: if false;
        allow create: if isUser(userId) && canAccessWorkspace()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.userId == userId;
        allow update: if isUser(userId) && resource.data.workspaceId == workspaceId
          && request.resource.data.workspaceId == workspaceId
          && fieldUnchanged('userId');
        allow delete: if false;
      }

      // ─── Conversations / Chat ──────────────────────────────
      match /conversations/{conversationId} {
        allow read: if canAccessWorkspace()
          && resource.data.memberIds.hasAny([request.auth.uid]);
        allow create: if canAccessWorkspace()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.conversationId == conversationId
          && isValidClientActor(request.resource.data.createdBy)
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() >= 1
          && request.resource.data.memberIds.size() <= 50
          && request.resource.data.memberIds.hasAny([request.auth.uid]);
        allow update: if canAccessWorkspace() && isConversationMember(conversationId)
          && fieldUnchanged('workspaceId') && fieldUnchanged('conversationId')
          && fieldUnchanged('type') && fieldUnchanged('memberIds')
          && fieldUnchanged('createdBy') && fieldUnchanged('_createdAt');
        allow delete: if false;

        match /members/{userId} {
          allow read: if canAccessWorkspace() && isConversationMember(conversationId);
          allow create: if canAccessWorkspace()
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.conversationId == conversationId
            && request.resource.data.userId == userId
            && userCanAccessWorkspace(userId)
            && (
              isConversationMember(conversationId)
              || getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/conversations/$(conversationId)).data.createdBy.actorId == request.auth.uid
            );
          allow update, delete: if false;
        }

        match /messages/{messageId} {
          allow get: if canAccessWorkspace() && isConversationMember(conversationId);
          allow list: if canAccessWorkspace() && isConversationMember(conversationId)
            && request.query.limit <= 50;
          allow create: if canAccessWorkspace() && isConversationMember(conversationId)
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.conversationId == conversationId
            && request.resource.data.messageId == messageId
            && request.resource.data.senderUserId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      // ─── Ledger Books ─────────────────────────────────────
      // Path: workspaces/{workspaceId}/ledgerBooks/{ledgerBookId}
      // Numbered registers. Multiple independent books per workspace.

      match /ledgerBooks/{ledgerBookId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy != null
          && isValidClientActor(request.resource.data.createdBy)
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Update: immutable identity/numbering fields protected
        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('ledgerBookId')
          && fieldUnchanged('ledgerCode')
          && fieldUnchanged('createdBy')
          && fieldUnchanged('numberingStrategy')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow delete: if false;

        // ─── Ledger Blocks (subcollection) ────────────────────
        // Path: workspaces/{workspaceId}/ledgerBooks/{ledgerBookId}/blocks/{blockId}

        match /blocks/{blockId} {
          allow read: if isAuthenticated()
            && (
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
                && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
                && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
            );

          allow create: if isAuthenticated()
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.ledgerBookId == ledgerBookId
            && (
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
                && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
                && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
            );

          // Update: immutable identity fields protected
          allow update: if isAuthenticated()
            && fieldUnchanged('workspaceId')
            && fieldUnchanged('ledgerBookId')
            && fieldUnchanged('ledgerBlockId')
            && fieldUnchanged('blockNumber')
            && fieldUnchanged('startSequence')
            && fieldUnchanged('endSequence')
            && fieldUnchanged('capacity')
            && fieldUnchanged('createdBy')
            && (
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
                && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
              ||
              (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
                && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
            );

          allow delete: if false;
        }
      }

      // ─── Ledger Entries ───────────────────────────────────
      // Path: workspaces/{workspaceId}/ledgerEntries/{ledgerEntryId}
      // Immutable registration records. Sequence numbers never reused.

      match /ledgerEntries/{ledgerEntryId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.registeredBy != null
          && isValidClientActor(request.resource.data.registeredBy)
          // Provenance: referenced Record must exist in the same workspace
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/records/$(request.resource.data.recordId))
          // Provenance: referenced LedgerBook must exist in the same workspace
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/ledgerBooks/$(request.resource.data.ledgerBookId))
          // Entry must be created with ACTIVE status
          && request.resource.data.entryStatus == 'ACTIVE'
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Update: identity and numbering immutable; only status transitions allowed
        allow update: if isAuthenticated()
          && fieldUnchanged('workspaceId')
          && fieldUnchanged('ledgerEntryId')
          && fieldUnchanged('ledgerBookId')
          && fieldUnchanged('ledgerBlockId')
          && fieldUnchanged('recordId')
          && fieldUnchanged('moduleId')
          && fieldUnchanged('moduleVersion')
          && fieldUnchanged('recordType')
          && fieldUnchanged('sequenceNumber')
          && fieldUnchanged('referenceNumber')
          && fieldUnchanged('referenceFormatVersion')
          && fieldUnchanged('registeredAt')
          && fieldUnchanged('registeredBy')
          && fieldUnchanged('_registeredAt')
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Ledger entries are NEVER deleted
        allow delete: if false;
      }

      // ─── Ledger Codes ─────────────────────────────────────
      // Path: workspaces/{workspaceId}/ledgerCodes/{ledgerCode}
      // Deterministic reservation for code uniqueness.

      match /ledgerCodes/{ledgerCode} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Code reservations are immutable
        allow update: if false;
        allow delete: if false;
      }

      // ─── Audit Entries ────────────────────────────────────
      // Path: workspaces/{workspaceId}/auditEntries/{auditEntryId}
      // Append-only accountability history.

      match /auditEntries/{auditEntryId} {
        allow read: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Create: actor must be valid client actor
        allow create: if isAuthenticated()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.actor != null
          && request.resource.data.actor.actorType == 'USER'
          && request.resource.data.actor.actorId == request.auth.uid
          && (
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'PERSONAL'
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUserId == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type == 'ORGANIZATION'
              && isActiveMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.organizationId))
          );

        // Audit entries are NEVER updated or deleted
        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── Organizations ──────────────────────────────────────
    // Path: organizations/{organizationId}

    match /organizations/{organizationId} {
      // Read: only active members
      allow read: if isActiveMember(organizationId);

      // Create: any authenticated user can create an org
      // The createdByUserId must match the authenticated user
      allow create: if isAuthenticated()
        && request.resource.data.createdByUserId == request.auth.uid;

      // Update: only OWNER or ADMIN
      // Protected fields: createdByUserId, organizationId, type cannot change
      allow update: if isAdminOrOwner(organizationId)
        && fieldUnchanged('createdByUserId')
        && fieldUnchanged('organizationId')
        && fieldUnchanged('type');

      allow delete: if false;

      // ─── Members (subcollection) ──────────────────────────
      // Path: organizations/{organizationId}/members/{userId}
      // Deterministic path enables security rule lookups.

      match /members/{memberId} {
        // Read: active members of this org can see other members
        allow read: if isActiveMember(organizationId);

        // Create: the FIRST member (org creator) is written in a batch
        // with the org itself. We allow if the creator is creating
        // their own OWNER membership for an org they are creating.
        // Subsequent members are created by ADMIN/OWNER.
        allow create: if isAuthenticated()
          && (
            // Bootstrap: user is creating their own OWNER membership
            (
              memberId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.roles.hasAny(['OWNER'])
              && request.resource.data.status == 'ACTIVE'
              && request.resource.data.organizationId == organizationId
            )
            ||
            // Admin/Owner adding a new member (cannot grant OWNER)
            (
              isAdminOrOwner(organizationId)
              && request.resource.data.organizationId == organizationId
              && !request.resource.data.roles.hasAny(['OWNER'])
            )
          );

        // Update: only ADMIN/OWNER can update memberships
        // Cannot change organizationId or userId
        // Cannot add OWNER role unless already OWNER
        // Cannot modify your own roles (to prevent self-promotion)
        allow update: if isAdminOrOwner(organizationId)
          && fieldUnchanged('organizationId')
          && fieldUnchanged('userId')
          && (
            // If new data has OWNER role, existing data must already have OWNER
            // (prevents ADMIN from granting OWNER to anyone)
            !request.resource.data.roles.hasAny(['OWNER'])
            || resource.data.roles.hasAny(['OWNER'])
          )
          // Prevent self-modification of roles
          && (
            memberId != request.auth.uid
            || fieldUnchanged('roles')
          );

        allow delete: if false;
      }

      // ─── Groups (subcollection) ───────────────────────────
      // Path: organizations/{organizationId}/groups/{groupId}

      match /groups/{groupId} {
        // Read: active members only
        allow read: if isActiveMember(organizationId);

        // Create: ADMIN or OWNER
        // organizationId in data must match parent path
        allow create: if isAdminOrOwner(organizationId)
          && request.resource.data.organizationId == organizationId;

        // Update: ADMIN or OWNER
        // Cannot change organizationId
        allow update: if isAdminOrOwner(organizationId)
          && fieldUnchanged('organizationId');

        // Delete: ADMIN or OWNER
        allow delete: if isAdminOrOwner(organizationId);
      }

      // ─── Invitations (subcollection) ──────────────────────
      // Path: organizations/{organizationId}/invitations/{invitationId}

      match /invitations/{invitationId} {
        // Read: ADMIN/OWNER of the org, or the invited user (by email in auth token)
        allow read: if isAdminOrOwner(organizationId);

        // Create: ADMIN or OWNER
        // organizationId must match, invitedByUserId must be the auth user
        // Cannot create invitations with OWNER role
        allow create: if isAdminOrOwner(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.invitedByUserId == request.auth.uid
          && !request.resource.data.role.matches('OWNER');

        // Update: ADMIN/OWNER can revoke; acceptance is server-side only
        allow update: if isAdminOrOwner(organizationId)
          && fieldUnchanged('organizationId')
          && fieldUnchanged('email')
          && fieldUnchanged('invitedByUserId');

        allow delete: if false;
      }
    }

    // ─── User Membership Index ──────────────────────────────
    // Path: userMemberships/{userId}/orgs/{organizationId}
    // Read-only index for "get my memberships" queries.
    // Written atomically with the canonical member doc.

    match /userMemberships/{userId} {
      // No document at this level
      allow read, write: if false;

      match /orgs/{organizationId} {
        // User can read their own membership index
        allow read: if isUser(userId);

        // Written by batch operations during member create/update
        // Only the user themselves or an admin of the org can write
        allow create: if isAuthenticated()
          && (
            isUser(userId)
            || isAdminOrOwner(organizationId)
          );

        allow update: if isAuthenticated()
          && (
            isUser(userId)
            || isAdminOrOwner(organizationId)
          );

        allow delete: if false;
      }
    }

    // ─── Deny by default ────────────────────────────────────
    // Any collection not explicitly matched above is inaccessible.
    // This is enforced by Firestore's default deny behavior.
    // The following catch-all makes it explicit for documentation.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
