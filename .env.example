# Modulity 2.0 — Environment Variables Example
# Copy this file to .env and fill in real values.
# Never commit real values to the repository.

# Application
VITE_APP_NAME=Modulity
VITE_APP_ENV=development

# Firebase (example provider)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Billing / Entitlements
BILLING_PROVIDER=stripe
DEFAULT_CONNECTION_LIMIT=5

# Agent providers (optional; agents do not run without explicit registration)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# API
API_BASE_URL=http://localhost:5173/api
WEBHOOK_SECRET=
